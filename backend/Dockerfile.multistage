# ---------------------------------------------------------------------------
# Dockerfile.multistage — image used by spring/spring-deployment.yaml
#
#   * multi-stage: build with Maven + JDK, ship only a JRE + the jar
#   * dependency layer caching: pom.xml is copied first, so code changes do
#     not re-download dependencies
#   * runs as an unprivileged, non-root user
#   * small Alpine-based runtime image with a HEALTHCHECK
#
# Build:  docker build -f Dockerfile.multistage -t tickets-backend:multistage .
# Run:    docker run --rm --network tickets-net -e DB_HOST=tickets-db -p 8080:8080 tickets-backend:multistage
#         (needs the PostgreSQL container "tickets-db" on network "tickets-net", see README)
# ---------------------------------------------------------------------------

# ===== Stage 1: build =======================================================
FROM maven:3.9-eclipse-temurin-25 AS build

WORKDIR /build

# 1) Only the pom first -> this layer (and the downloaded deps) is cached
#    until pom.xml changes.
COPY pom.xml .
RUN mvn -B dependency:go-offline

# 2) Now the source code. Changing a .java file only re-runs from here.
COPY src ./src
RUN mvn -B package -DskipTests

# ===== Stage 2: runtime =====================================================
FROM eclipse-temurin:25-jre-alpine

# Create an unprivileged system user/group to run the app.
RUN addgroup -S spring && adduser -S -G spring -H -s /sbin/nologin spring

WORKDIR /app

# Copy ONLY the jar from the build stage, owned by root and read-only for the
# app user: the process can run it but cannot modify it.
COPY --from=build /build/target/app.jar app.jar

# Everything from here on (RUN, CMD, docker exec) runs as this user.
# A numeric UID would also work and is preferred by Kubernetes' runAsNonRoot.
USER spring:spring

EXPOSE 8080

# Let the JVM size its heap from the container memory limit (docker run -m ...).
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"

# busybox wget is available on Alpine; curl is not.
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

# Exec form -> java is PID 1 and receives SIGTERM from `docker stop`.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
