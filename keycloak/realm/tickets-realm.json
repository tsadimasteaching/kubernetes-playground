{
  "realm": "tickets",
  "displayName": "Tickets",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "client": {
      "tickets-backend": [
        {
          "name": "USER",
          "description": "Creates tickets and edits or deletes their own OPEN tickets"
        },
        {
          "name": "AGENT",
          "description": "Sees all tickets, assigns them to themselves and resolves them"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "tickets-backend",
      "name": "Tickets API",
      "description": "The Spring Boot API. It never logs anyone in; it only owns the roles USER and AGENT and is the audience of the access tokens.",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "tickets-frontend",
      "name": "Tickets UI",
      "description": "The Vue single-page app: public client, Authorization Code flow with PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "",
      "redirectUris": [
        "http://vue.localhost:8080/*",
        "http://localhost:5173/*",
        "http://localhost:8081/*",
        "https://tickets.tsadimas.dns-cloud.net/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience tickets-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "tickets-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles of tickets-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "tickets-backend",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tickets-cli",
      "name": "Tickets command line (testing only)",
      "description": "Public client with the password grant, to get a token with curl. Do not use the password grant in real applications.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience tickets-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "tickets-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles of tickets-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "tickets-backend",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "clientRoles": { "tickets-backend": ["USER"] }
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "clientRoles": { "tickets-backend": ["USER"] }
    },
    {
      "username": "agent",
      "enabled": true,
      "email": "agent@example.com",
      "emailVerified": true,
      "firstName": "Support",
      "lastName": "Agent",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "clientRoles": { "tickets-backend": ["AGENT"] }
    }
  ]
}
