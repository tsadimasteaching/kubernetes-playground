// For format details, see https://aka.ms/devcontainer.json
{
	"name": "kubernetes-playground",
	// Ubuntu 24.04 (noble)
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

	// More info: https://containers.dev/features
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"version": "1.37.2",
			"helm": "latest",
			"minikube": "latest"
		}
	},

	// Ports forwarded to the local machine.
	"forwardPorts": [8001, 5000],

	// Installs k9s, kustomize, fzf and shell aliases.
	"postCreateCommand": "/bin/bash -c .devcontainer/startup_script.sh",
	// Kubernetes version of the minikube cluster (keep in sync with kubectl above).
	"postAttachCommand": "minikube start --kubernetes-version=v1.37.0",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"hashicorp.terraform",
				"ms-kubernetes-tools.vscode-kubernetes-tools"
			]
		}
	},
	"hostRequirements": {
		"cpus": 4,
		"memory": "8gb",
		"storage": "32gb"
	}
}
